    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jsonrepair": "^3.13.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
