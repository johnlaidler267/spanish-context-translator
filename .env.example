# Copy this file to .env and fill in the values.
# See README.md → "Environment variables" for details on each one.

# --- Required ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_ANNUAL=

# --- Optional ---

# Translation/learn flows use gemini-chat by default; set to "groq" to use groq-chat instead.
# VITE_TRANSLATION_LLM_PROVIDER=groq
# VITE_GEMINI_MODEL=
# VITE_GEMINI_MODEL_LEARN=

# Set to "true" to enforce usage limits during local dev (skipped by default).
# VITE_ENFORCE_USAGE_IN_DEV=true

# Set to "true" to exercise the lapsed-subscription UI locally.
# VITE_SIMULATE_LAPSED=true
